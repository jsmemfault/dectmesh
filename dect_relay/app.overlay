/*
 * Relay overlay. Inter-chip links to the nRF9151: uart1 (9P /net/aether) and
 * uart0 (the 9151's console/shell). Three USB CDC ACM ports front it all:
 *   cdc0 = 9151 console   cdc1 = 9P   cdc2 = the 5340's OWN console.
 */

/ {
	chosen {
		zephyr,console = &cdc_acm_uart2;  /* relay's own log -> USB (CDC2) */
	};
};

/* 9151 9P transport (its uart1) -> BLE L2CAP. */
&uart1 {
	status = "okay";
	current-speed = <115200>;
};

/* 9151 console/shell (its uart0) -> USB CDC ACM. */
&uart0 {
	status = "okay";
	current-speed = <115200>;
};

/* Composite USB: THREE CDC ACM ports (max on nRF5340: 2 IN + 1 OUT eps each).
 *   cdc_acm_uart0 -> 9151 console/shell (byte-pump from uart0)
 *   cdc_acm_uart1 -> 9P (aggregator re-export server / pump to the 9151)
 *   cdc_acm_uart2 -> the 5340's OWN console (this relay's log over USB)
 * The board defines &usbd (nordic,nrf-usbd); we add the CDC ACM functions. */
&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
	cdc_acm_uart1: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
	};
	cdc_acm_uart2: cdc_acm_uart2 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
