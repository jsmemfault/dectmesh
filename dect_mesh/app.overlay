/*
 * 9P transport UART. The /net/aether 9P server runs on this UART, separate from
 * the console (uart0). On the Thingy:91X, uart1 is an inter-chip link to the
 * nRF5340, which relays it to BLE L2CAP for clients. On a DK, uart1 is the
 * second VCOM, so the server can be reached directly for bring-up testing.
 */

/ {
	chosen {
		zephyr,ninep-uart = &uart1;
	};
};

&uart1 {
	status = "okay";
	/* Inter-chip 9P link to the nRF5340. Bumped 115200 -> 1 Mbps to lift the
	 * funnel for /net/aether datagram traffic. MUST match the 5340 side; flash
	 * both together (a mismatch breaks the link). Drop to 921600/460800 if the
	 * short inter-chip traces show overruns under sustained OTA streaming. */
	current-speed = <1000000>;
};
