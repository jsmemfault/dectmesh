/*
 * nRF9151 DK overlay (mesh node bring-up).
 *
 * This board overlay is auto-applied ONLY for board nrf9151dk/nrf9151/ns, and
 * it REPLACES app.overlay (a board overlay takes precedence over app.overlay in
 * Zephyr's default search), so it must be self-contained.
 *
 * Two DK-specific fixups vs the Thingy:91 X the app targets by default:
 *
 * 1. Mesh-state LEDs. The DK has no RGB LED, so instead of the Thingy's
 *    red/green/blue channels, aether_led.c uses a 4-discrete-LED scheme keyed on
 *    the topo_* nodelabels below (its #if DT_NODE_EXISTS(topo_root) branch):
 *      topo_alive -> LED1 (P0.00)  solid=settled in mesh, blink=searching
 *      topo_child -> LED2 (P0.01)  joined as a child
 *      topo_root  -> LED3 (P0.04)  this node is the HONR root
 *      topo_rx    -> LED4 (P0.05)  datagram activity flash
 *
 * 2. 9P server UART. The app's 9P server needs a chosen zephyr,ninep-uart. On the
 *    Thingy that's uart1 (inter-chip link to the nRF5340, relayed to BLE/USB). The
 *    DK has no spare host VCOM and uart1 is owned by TF-M, so 9P-over-USB is not
 *    available here — this DK is observed via its console shell (uart0/VCOM0) and
 *    is a mesh radio, not a 9P gateway (that's the Thingy's role). To keep the 9P
 *    server's build dependency satisfied we free SERIAL2 (disable the unused
 *    Arduino i2c2 + its unreferenced pcal6408a expander) and bind uart2 to the
 *    freed P0.30/P0.31 pins. The 9P server runs but is not reachable from the host.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	aether_topo_leds {
		compatible = "gpio-leds";
		topo_alive: topo_alive {
			gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
			label = "Aether alive";
		};
		topo_child: topo_child {
			gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
			label = "Aether child";
		};
		topo_root: topo_root {
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
			label = "Aether root";
		};
		topo_rx: topo_rx {
			gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
			label = "Aether rx";
		};
	};

	chosen {
		zephyr,ninep-uart = &uart2;
	};
};

&pinctrl {
	uart2_default: uart2_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 30)>,
				<NRF_PSEL(UART_RX, 0, 31)>;
		};
	};

	uart2_sleep: uart2_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 30)>,
				<NRF_PSEL(UART_RX, 0, 31)>;
			low-power-enable;
		};
	};
};

/* Free SERIAL2 (uart2/i2c2 share the instance) for the 9P server UART. */
&i2c2 {
	status = "disabled";
};

&uart2 {
	status = "okay";
	current-speed = <1000000>;
	pinctrl-0 = <&uart2_default>;
	pinctrl-1 = <&uart2_sleep>;
	pinctrl-names = "default", "sleep";
};
