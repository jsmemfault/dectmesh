 *
 * Custom Memfault heartbeat metrics for the DECT NR+ mesh. Counters accumulate
 * over a heartbeat interval and reset each interval; gauges report the latest
 * value at the end of the interval.
 */

/* Per-interval counters. */
MEMFAULT_METRICS_KEY_DEFINE(dect_originated, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(dect_relayed, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(dect_delivered, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(dect_dups_dropped, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(dect_tx_failures, kMemfaultMetricType_Unsigned)

/* Gauges. */
MEMFAULT_METRICS_KEY_DEFINE(dect_neighbors, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(dect_max_hops, kMemfaultMetricType_Unsigned)
MEMFAULT_METRICS_KEY_DEFINE(dect_rx_rssi_dbm, kMemfaultMetricType_Signed)
